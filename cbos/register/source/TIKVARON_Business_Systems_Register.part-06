n","Scenario planning with financial impact quantification","Unassigned","Unassigned"],["Portfolio and product lifecycle planning","Portfolio and product lifecycle planning","Unassigned","Unassigned"],["Monthly IBP cycle with executive decision forums","Monthly IBP cycle with executive decision forums","Unassigned","Unassigned"],["Forecast accuracy tracking and bias monitoring","Forecast accuracy tracking and bias monitoring","Unassigned","Unassigned"]]],["FP&A Platform",[["Driver-Based Financial Models","Revenue, cost, headcount modeling","$1M ARR","High"],["Rolling Forecasts","Continuous reforecasting, variance analysis","$1M ARR","High"],["Budgeting Process Management","Calendar, templates, approval workflows","$1M ARR","High"],["What-If Analysis & Sensitivity","Scenario modeling, risk assessment","$1M ARR","Medium"],["Rolling forecasts and continuous reforecasting","Rolling forecasts and continuous reforecasting","Unassigned","Unassigned"],["Management reporting packs","board-ready, variance analysis","Unassigned","Unassigned"],["Headcount and opex planning linked to strategy","Headcount and opex planning linked to strategy","Unassigned","Unassigned"],["What-if analysis and sensitivity modeling","What-if analysis and sensitivity modeling","Unassigned","Unassigned"],["Consolidation and close management","Consolidation and close management","Unassigned","Unassigned"]]],["Digital Transformation Office",[["Transformation Portfolio","Initiative tracking, value realization","$10M ARR","Medium"],["Change Management Methodology","ADKAR, Prosci, adoption metrics","$1M ARR","Medium"],["Citizen Development Programs","Low-code/no-code enablement with governance","$1M ARR","Medium"],["Digital Dexterity Assessment","Workforce readiness evaluation","$1M ARR","Medium"],["Transformation portfolio and initiative tracking","Transformation portfolio and initiative tracking","Unassigned","Unassigned"],["Change management methodology (ADKAR, Kotter, Prosci)","Change management methodology (ADKAR, Kotter, Prosci)","Unassigned","Unassigned"],["Adoption and proficiency metrics per rollout","Adoption and proficiency metrics per rollout","Unassigned","Unassigned"],["Business process reengineering and value stream mapping","Business process reengineering and value stream mapping","Unassigned","Unassigned"],["Digital dexterity assessment and workforce readiness","Digital dexterity assessment and workforce readiness","Unassigned","Unassigned"],["Transformation communication and engagement plan","Transformation communication and engagement plan","Unassigned","Unassigned"]]],["Organizational Learning & Knowledge",[["Communities of Practice","Expertise networks, knowledge sharing","$1M ARR","Medium"],["Expert Directory & Matching","Internal expert discovery","$1M ARR","Low"],["Organizational Memory","Decisions, rationale, outcomes capture","$1M ARR","Medium"],["Lessons-Learned Database","Integration into workflow, searchable","First Revenue","Medium"],["Communities of practice and expertise networks","Communities of practice and expertise networks","Unassigned","Unassigned"],["Expert directories and internal expert matching","Expert directories and internal expert matching","Unassigned","Unassigned"],["Knowledge graph for enterprise knowledge","Knowledge graph for enterprise knowledge","Unassigned","Unassigned"],["Lessons-learned databases integrated into workflow","Lessons-learned databases integrated into workflow","Unassigned","Unassigned"],["Internal consulting / centers of excellence design","Internal consulting / centers of excellence design","Unassigned","Unassigned"],["Knowledge transfer protocols for role transitions and departures","Knowledge transfer protocols for role transitions and departures","Unassigned","Unassigned"]]],["Corporate Reputation & Brand",[["Reputation Monitoring","Social listening, sentiment, reviews","First Revenue","Medium"],["Brand Architecture Management","Master brand, sub-brands, naming","First Revenue","Medium"],["Stakeholder Mapping & Engagement","Investors, regulators, community","$1M ARR","Medium"],["Thought Leadership Platform","Executive visibility, publications","$1M ARR","Medium"],["Brand portfolio and architecture management","master brand, sub-brands, endorsed brands","Unassigned","Unassigned"],["Naming and trademark screening process","Naming and trademark screening process","Unassigned","Unassigned"],["Stakeholder mapping and engagement strategy","investors, regulators, community, employees","Unassigned","Unassigned"],["Thought leadership platform and executive visibility program","Thought leadership platform and executive visibility program","Unassigned","Unassigned"],["Crisis reputation recovery playbooks","Crisis reputation recovery playbooks","Unassigned","Unassigned"],["Corporate brand valuation and tracking","Corporate brand valuation and tracking","Unassigned","Unassigned"]]],["Sustainability & Impact",[["Science-Based Targets (SBTi)","Commitment and progress tracking","$10M ARR","Medium"],["Scope 3 Emissions Measurement","Value chain carbon accounting","$10M ARR","Medium"],["Impact Measurement (IMP)","Social and environmental outcomes","$10M ARR","Low"],["Circular Economy Programs","Product stewardship, e-waste","$10M ARR","Low"],["Science-based targets (SBTi) commitment and progress tracking","Science-based targets (SBTi) commitment and progress tracking","Unassigned","Unassigned"],["Scope 3 emissions measurement across value chain","Scope 3 emissions measurement across value chain","Unassigned","Unassigned"],["Circular economy and product stewardship programs","Circular economy and product stewardship programs","Unassigned","Unassigned"],["Biodiversity and nature-related risk (TNFD readiness)","Biodiversity and nature-related risk (TNFD readiness)","Unassigned","Unassigned"],["Just transition and community impact planning","Just transition and community impact planning","Unassigned","Unassigned"],["Impact measurement and management (IMP) frameworks","Impact measurement and management (IMP) frameworks","Unassigned","Unassigned"],["Green bonds / sustainability-linked financing","Green bonds / sustainability-linked financing","Unassigned","Unassigned"]]],["Public Affairs & Social License",[["Community Relations","Local stakeholder engagement","$10M ARR","Medium"],["Issue Advocacy & Policy Positioning","Strategic positioning on key issues","$10M ARR","Medium"],["Grassroots Employee Advocacy","Amplification through employees","$10M ARR","Low"],["Political Risk Assessment","Market entry risk analysis","$10M ARR","Medium"],["Community relations and local stakeholder engagement","Community relations and local stakeholder engagement","Unassigned","Unassigned"],["Grassroots advocacy and coalition building","Grassroots advocacy and coalition building","Unassigned","Unassigned"],["Government contract and public sector engagement (expanded)","Government contract and public sector engagement (expanded)","Unassigned","Unassigned"],["Political risk assessment for market entry","Political risk assessment for market entry","Unassigned","Unassigned"],["Issue advocacy and policy positioning","Issue advocacy and policy positioning","Unassigned","Unassigned"],["Grassroots employee advocacy programs","Grassroots employee advocacy programs","Unassigned","Unassigned"],["Social listening for political and regulatory signals","Social listening for political and regulatory signals","Unassigned","Unassigned"]]]];
const INVENTORY = [];
REGISTER.forEach((category, categoryIndex) => category[1].forEach((system, systemIndex) => {
  INVENTORY.push({id:`c${categoryIndex}_s${systemIndex}`, category:category[0], categoryIndex, systemIndex, name:system[0], description:system[1], sourceStage:system[2], sourcePriority:system[3]});
}));
const state = {edits:{}, filters:{search:'',stage:'',priority:'',maturity:'',owner:'',decision:'',category:''}, collapsed:Object.fromEntries(REGISTER.map((_,i)=>[i,i>=9]))};
let storageAvailable = true;
let toastTimer;
const $ = id => document.getElementById(id);
const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
const getEdit = item => state.edits[item.id] || {};
const getValue = (item, field) => {
  const edit = getEdit(item);
  if (field === 'stage') return edit.stage || item.sourceStage;
  if (field === 'priority') return edit.priority || item.sourcePriority;
  if (field === 'decision') return edit.decision || 'Unassessed';
  if (field === 'status') return edit.status || 'Not started';
  if (field === 'monthlyCost') return Number.isFinite(edit.monthlyCost) ? edit.monthlyCost : null;
  if (field === 'reviewCadence') return edit.reviewCadence || '';
  if (field === 'reviewDate') return edit.reviewDate || '';
  if (field === 'dependencies') return edit.dependencies || '';
  if (field === 'trigger') return edit.trigger || '';
  if (field === 'notes') return edit.notes || '';
  if (field === 'owner') return edit.owner || '';
  if (field === 'maturity') return Number.isInteger(edit.maturity) && edit.maturity >= 0 && edit.maturity <= 4 ? edit.maturity : null;
  return '';
};
const fullStats = () => {
  const scored = INVENTORY.map(item => getValue(item,'maturity')).filter(v => v !== null);
  const maturityAverage = scored.length ? scored.reduce((a,b)=>a+b,0) / scored.length / 4 * 100 : null;
  const assigned = INVENTORY.filter(item => getValue(item,'owner').trim()).length;
  const critical = INVENTORY.filter(item => getValue(item,'priority') === 'Critical').length;
  return {scored, maturityAverage, assigned, critical};
};
function showToast(message){const el=$('toast');el.textContent=message;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2400);}
function saveState(){
  try {safeStorage.setItem(STORAGE_KEY,JSON.stringify({version:2,edits:state.edits}));storageAvailable=true;$('storageState').textContent='● Saved in this browser';$('storageState').classList.remove('warn');}
  catch(error){storageAvailable=false;$('storageState').textContent='! Backup required';$('storageState').classList.add('warn');}
}
function loadState(){
  try {const raw=safeStorage.getItem(STORAGE_KEY);if(raw){const parsed=JSON.parse(raw);if(parsed && [1,2].includes(parsed.version) && parsed.edits && typeof parsed.edits==='object') state.edits=parsed.edits;} $('storageState').textContent='● Saved in this browser';}
  catch(error){storageAvailable=false;$('storageState').textContent='! Backup required';$('storageState').classList.add('warn');}
}
function updateStats(){
  const stats=fullStats();
  $('statSystems').textContent=INVENTORY.length.toLocaleString();
  $('statCategories').textContent=REGISTER.length.toLocaleString();
  $('statMaturity').textContent=stats.maturityAverage===null?'—':`${Math.round(stats.maturityAverage)}%`;
  $('statMaturitySub').textContent=stats.scored.length?`${stats.scored.length} of ${INVENTORY.length} systems assessed`:'No systems assessed';
  $('statOwners').textContent=`${(stats.assigned/INVENTORY.length*100).toFixed(1)}%`;
  $('statOwnersSub').textContent=`${stats.assigned} of ${INVENTORY.length} owners assigned`;
  $('statCritical').textContent=stats.critical.toLocaleString();
  const counts=[0,1,2,3,4].map(level=>INVENTORY.filter(item=>getValue(item,'maturity')===level).length);
  const rated=counts.reduce((a,b)=>a+b,0);
  $('maturitySummary').textContent=rated?`${rated} scored · ${INVENTORY.length-rated} not yet assessed · average maturity ${Math.round(stats.maturityAverage)}%`:'No maturity scores entered yet. Score each system from 0 to 4.';
  $('distribution').innerHTML = rated ? counts.map((n,i)=>n?`<span class="dist-${i}" style="width:${n/rated*100}%" title="${MATURITY[i]}: ${n}"></span>`:'').join('') : '<span style="width:100%;background:#526357"></span>';
  $('distributionLegend').innerHTML = MATURITY.map((name,i)=>`<span class="legend-item"><i class="legend-dot dist-${i}"></i>${esc(name)}: ${counts[i]}</span>`).join('');
}
function fillStageFilters(){
  $('stageFilter').innerHTML='<option value="">All stages</option>'+STAGES.map(stage=>`<option value="${esc(stage)}">${esc(stage)}</option>`).join('');
  $('stageChips').innerHTML=[['','All'],...STAGES.map(s=>[s,s])].map(([value,label])=>`<button type="button" class="stage-chip" data-stage="${esc(value)}">${esc(label)}</button>`).join('');
}
function renderSidebar(){
  $('sidebarCount').textContent=`${REGISTER.length}`;
  $('catNav').innerHTML=`<li><button type="button" data-category="" class="${state.filters.category===''?'active':''}"><span class="cat-number">✦</span><span class="cat-name">All categories</span><span class="cat-count">${INVENTORY.length}</span></button></li>`+REGISTER.map((cat,i)=>`<li><button type="button" data-category="${i}" class="${String(state.filters.category)===String(i)?'active':''}"><span class="cat-number">${String(i+1).padStart(2,'0')}</span><span class="cat-name">${esc(cat[0])}</span><span class="cat-count">${cat[1].length}</span></button></li>`).join('');
}
function filteredRecords(){
  const f=state.filters;const q=f.search.trim().toLowerCase();
  return INVENTORY.filter(item=>{
    const owner=getValue(item,'owner'),stage=getValue(item,'stage'),priority=getValue(item,'priority'),maturity=getValue(item,'maturity');
    const decision=getValue(item,'decision');
    const edit=getEdit(item);
    if(q && ![item.name,item.description,item.category,owner,stage,priority,decision,edit.status,edit.trigger,edit.dependencies,edit.notes].some(v=>String(v??'').toLowerCase().includes(q))) return false;
    if(f.stage && stage!==f.stage) return false;
    if(f.priority && priority!==f.priority) return false;
    if(f.category!=='' && item.categoryIndex!==Number(f.category)) return false;
    if(f.maturity==='unrated' && maturity!==null) return false;
    if(f.maturity!=='' && f.maturity!=='unrated' && maturity!==Number(f.maturity)) return false;
    if(f.owner==='assigned' && !owner.trim()) return false;
    if(f.owner==='unassigned' && owner.trim()) return false;
    if(f.decision && decision!==f.decision) return false;
    return true;
  });
}
function stageClass(stage){return 'stage-'+stage.toLowerCase().replace(/[^a-z0-9]+/g,'-');}
function renderContent(){
  const records=filteredRecords();
  const grouped=new Map();records.forEach(item=>{if(!grouped.has(item.categoryIndex))grouped.set(item.categoryIndex,[]);grouped.get(item.categoryIndex).push(item);});
  $('filterSummary').textContent=`Showing ${records.length} of ${INVENTORY.length}`;
  $('contentTitle').textContent=state.filters.category===''?'All business systems':REGISTER[Number(state.filters.category)][0];
  $('contentSubtitle').textContent=`${records.length} matching records · maturity and ownership are editable inline`;
  $('stageFilter').value=state.filters.stage;
  $('priorityFilter').value=state.filters.priority;
  $('maturityFilter').value=state.filters.maturity;
  $('ownerFilter').value=state.filters.owner;
  $('decisionFilter').value=state.filters.decision;
  $('searchInput').value=state.filters.search;
  document.querySelectorAll('.stage-chip').forEach(chip=>chip.classList.toggle('active',chip.dataset.stage===state.filters.stage));
  renderSidebar();
  if(!records.length){$('contentArea').innerHTML='<div class="empty"><strong>No matching systems</strong>Adjust the search or filters, or reset filters to view the inventory.</div>';return;}
  const html=[];
  const narrowed=!!(state.filters.search||state.filters.stage||state.filters.priority||state.filters.maturity||state.filters.owner||state.filters.decision||state.filters.category!=='');
  grouped.forEach((items,ci)=>{
    const collapsed=state.collapsed[ci]===true&&!narrowed;
    const category=REGISTER[ci][0];
    html.push(`<section class="section" id="category-${ci}"><button type="button" class="section-head" data-toggle="${ci}" aria-expanded="${!collapsed}"><span class="section-index">${String(ci+1).padStart(2,'0')}</span><span class="section-name">${esc(category)}</span><span class="section-meta">${items.length} system${items.length===1?'':'s'}</span><span class="section-chevron">${collapsed?'＋':'−'}</span></button>`);
    if(!collapsed){
      html.push('<div class="table-wrap"><table><thead><tr><th style="width:19%">System</th><th style="width:24%">Description</th><th style="width:13%">Stage</th><th style="width:10%">Priority</th><th style="width:19%">Maturity score</th><th style="width:13%">Accountable owner</th><th style="width:11%">Decision</th><th style="width:8%">Controls</th></tr></thead><tbody>');
      for(const item of items){
        const stage=getValue(item,'stage'),priority=getValue(item,'priority'),maturity=getValue(item,'maturity'),owner=getValue(item,'owner'),decision=getValue(item,'decision');
        const matOptions='<option value="">Unrated</option>'+MATURITY.map((name,i)=>`<option value="${i}" ${maturity===i?'selected':''}>${i} · ${esc(name)}</option>`).join('');
        const stageOptions=STAGES.map(s=>`<option value="${esc(s)}" ${stage===s?'selected':''}>${esc(s)}</option>`).join('');
        const priOptions=PRIORITIES.map(p=>`<option value="${p}" ${priority===p?'selected':''}>${p}</option>`).join('');
        const decisionOptions=['Unassessed','Build','Buy','Defer','Kill'].map(d=>`<option value="${d}" ${decision===d?'selected':''}>${d}</option>`).join('');
        const score=maturity===null?'Not scored':`${maturity*25}%`;
        html.push(`<tr data-id="${item.id}"><td><div class="sys-title">${esc(item.name)}</div></td><td><div class="sys-desc">${esc(item.description)}</div></td><td><select class="cell-select" data-field="stage" data-id="${item.id}" aria-label="Stage for ${esc(item.name)}">${stageOptions}</select></td><td><select class="cell-select" data-field="priority" data-id="${item.id}" aria-label="Priority for ${esc(item.name)}">${priOptions}</select></td><td class="maturity-cell"><select class="cell-select maturity-select" data-field="maturity" data-id="${item.id}" aria-label="Maturity score for ${esc(item.name)}">${matOptions}</select><div class="score-line">${maturity===null?'Awaiting assessment':`<span class="score-value">${score}</span> maturity score · ${esc(MATURITY[maturity])}`}</div></td><td><input class="owner-input" type="text" maxlength="80" value="${esc(owner)}" placeholder="Assign an owner…" data-field="owner" data-id="${item.id}" aria-label="Owner for ${esc(item.name)}"></td><td><select class="cell-select" data-field="decision" data-id="${item.id}" aria-label="Operating decision for ${esc(item.name)}">${decisionOptions}</select></td><td><button class="btn small manage-btn" type="button" data-manage-system="${item.id}">Manage</button></td></tr>`);
      }
      html.push('</tbody></table></div>');
    }
    html.push('</section>');
  });
  $('contentArea').innerHTML=html.join('');
}
function render(){updateStats();renderContent();}
function setFilter(key,value){state.filters[key]=value;renderContent();}
function resetFilters(){state.filters={search:'',stage:'',priority:'',maturity:'',owner:'',decision:'',category:''};render();}
function updateEdit(id,field,value){
  const row=state.edits[id] || (state.edits[id]={});
  if(field==='maturity'){
    row.maturity=value===''?null:Number(value);
    if(row.maturity===null) delete row.maturity;
  }else if(field==='owner'){
    if(String(value).trim()) row.owner=String(value).trim(); else delete row.owner;
  }else if(field==='stage'){
    if(STAGES.includes(value)) row.stage=value;
  }else if(field==='priority'){
    if(PRIORITIES.includes(value)) row.priority=value;
  }else if(field==='decision'){
    if(['Unassessed','Build','Buy','Defer','Kill'].includes(value)) row.decision=value;
  }else if(field==='status'){
    if(['Not started','Research','Planned','In progress','Operating','Blocked','Retired'].includes(value)) row.status=value;
  }else if(field==='monthlyCost'){
    if(value==='') delete row.monthlyCost; else {const n=Number(value);if(Number.isFinite(n)&&n>=0)row.monthlyCost=n;}
  }else if(field==='reviewCadence'){
    if(['','Weekly','Monthly','Quarterly','Annually','Event-driven'].includes(value)) row.reviewCadence=value;
  }else if(field==='reviewDate'){
    if(/^\d{4}-\d{2}-\d{2}$/.test(value))row.reviewDate=value;else delete row.reviewDate;
  }else if(['dependencies','trigger','notes'].includes(field)){
    const max=field==='notes'?1200:600; if(String(value).trim())row[field]=String(value).trim().slice(0,max);else delete row[field];
  }
  if(Object.keys(row).length===0) delete state.edits[id];
  saveState();
}
function csvCell(value){
  let text=String(value??'');
  if(/^[\s]*[=+@\-]/.test(text)) text="'"+text;
  return '"'+text.replace(/"/g,'""')+'"';
}
function exportCSV(all=false){
  const records=all?INVENTORY:filteredRecords();
  const headers=['Category','System','Description','Stage','Priority','Maturity Level','Maturity Score (%)','Owner','Decision','Operating Status','Estimated Monthly Cost KES','Review Cadence','Next Review Date','Dependencies','Activation Trigger','Operating Notes'];
  const lines=[headers.map(csvCell).join(',')];
  records.forEach(item=>{
    const maturity=getValue(item,'maturity');
    lines.push([item.category,item.name,item.description,getValue(item,'stage'),getValue(item,'priority'),maturity===null?'Unrated':MATURITY[maturity],maturity===null?'':maturity*25,getValue(item,'owner'),getValue(item,'decision'),getValue(item,'status'),getValue(item,'monthlyCost')??'',getValue(item,'reviewCadence'),getValue(item,'reviewDate'),getValue(item,'dependencies'),getValue(item,'trigger'),getValue(item,'notes')].map(csvCell).join(','));
  });
  downloadFile('\ufeff'+lines.join('\r\n'),all?'tikvaron-business-systems-full.csv':'tikvaron-business-systems-filtered.csv','text/csv;charset=utf-8');
  showToast(`CSV exported: ${records.length} systems`);
}
function downloadFile(content,name,type){
  const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function exportBackup(){
  const backup={format:'TIKVARON_CBOS_SYSTEMS_REGISTER',version:2,exportedAt:new Date().toISOString(),inventory:{categories:REGISTER.length,systems:INVENTORY.length},edits:state.edits,operations:opsTasks,calculator:currentCalcValues()};
  downloadFile(JSON.stringify(backup,null,2),'tikvaron-business-systems-backup.json','application/json');
  showToast('Backup downloaded. Keep it somewhere safe.');
}
function importBackup(file){
  const reader=new FileReader();reader.onload=()=>{
    try{
      const parsed=JSON.parse(reader.result);
      if(parsed.format!=='TIKVARON_CBOS_SYSTEMS_REGISTER'||![1,2].includes(parsed.version)||!parsed.edits||typeof parsed.edits!=='object') throw new Error('This is not a recognised TIKVARON register backup.');
      const validIds=new Set(INVENTORY.map(item=>item.id));
      const next={};
      Object.entries(parsed.edits).forEach(([id,edit])=>{if(validIds.has(id)&&edit&&typeof edit==='object'){
        const clean={};if(Number.isInteger(edit.maturity)&&edit.maturity>=0&&edit.maturity<=4)clean.maturity=edit.maturity;
        if(typeof edit.owner==='string'&&edit.owner.trim())clean.owner=edit.owner.slice(0,80).trim();
        if(STAGES.includes(edit.stage))clean.stage=edit.stage;if(PRIORITIES.includes(edit.priority))clean.priority=edit.priority;
        for(const key of ['decision','status','reviewCadence','reviewDate','dependencies','trigger','notes']){const v=edit[key];if(typeof v==='string')clean[key]=v.slice(0,key==='notes'?1200:600);}
        if(Number.isFinite(edit.monthlyCost)&&edit.monthlyCost>=0)clean.monthlyCost=edit.monthlyCost;
        if(['Unassessed','Build','Buy','Defer','Kill'].includes(edit.decision))clean.decision=edit.decision;
        if(Object.keys(clean).length)next[id]=clean;
      }});
      state.edits=next;if(parsed.operations&&Array.isArray(parsed.operations))opsTasks=parsed.operations;applyCalcValues(parsed.calculator);saveState();saveOps();render();renderOps();showToast('Backup restored successfully.');
    }catch(error){showToast(error.message||'Could not restore backup.');}
    $('restoreFile').value='';
  };reader.readAsText(file);
}
function expandCollapseAll(collapsed){
  REGISTER.forEach((_,i)=>{state.collapsed[i]=collapsed;});renderContent();
}
// Event wiring
$('searchInput').addEventListener('input',e=>{state.filters.search=e.target.value;renderContent();});
$('stageFilter').addEventListener('change',e=>setFilter('stage',e.target.value));
$('priorityFilter').addEventListener('change',e=>setFilter('priority',e.target.value));
$('maturityFilter').addEventListener('change',e=>setFilter('maturity',e.target.value));
$('ownerFilter').addEventListener('change',e=>setFilter('owner',e.target.value));
$('decisionFilter').addEventListener('change',e=>setFilter('decision',e.target.value));
$('stageChips').addEventListener('click',e=>{const chip=e.target.closest('[data-stage]');if(chip)setFilter('stage',chip.dataset.stage);});
$('catNav').addEventListener('click',e=>{const btn=e.target.closest('[data-category]');if(btn){state.filters.category=btn.dataset.category;renderContent();if(state.filters.category!=='')$('contentArea').scrollIntoView({behavior:'smooth',block:'start'});}});
$('contentArea').addEventListener('click',e=>{const manage=e.target.closest('[data-manage-system]');if(manage){openSystemManager(manage.dataset.manageSystem);return;}const btn=e.target.closest('[data-toggle]');if(btn){const i=Number(btn.dataset.toggle);state.collapsed[i]=!state.collapsed[i];renderContent();}});
$('contentArea').addEventListener('change',e=>{
  const el=e.target.closest('[data-field]');if(!el)return;
  const {id,field}=el.dataset;updateEdit(id,field,el.value);
  if(field!=='owner')render();else{updateStats();if(state.filters.owner==='assigned'||state.filters.owner==='unassigned'||state.filters.search)renderContent();}
});
$('contentArea').addEventListener('input',e=>{
  const el=e.target.closest('input[data-field="owner"]');if(!el)return;
  const {id}=el.dataset;updateEdit(id,'owner',el.value);
  updateStats();
});
$('resetBtn').addEventListener('click',resetFilters);
$('expandBtn').addEventListener('click',()=>expandCollapseAll(false));
$('collapseBtn').addEventListener('click',()=>expandCollapseAll(true));
$('exportBtn').addEventListener('click',()=>exportCSV(false));
$('exportAllBtn').addEventListener('click',()=>exportCSV(true));
$('backupBtn').addEventListener('click',exportBackup);
$('restoreBtn').addEventListener('click',()=>$('restoreFile').click());
$('restoreFile').addEventListener('change',e=>{if(e.target.files&&e.target.files[0])importBackup(e.target.files[0]);});
document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('searchInput').focus();}if(e.key==='Escape'&&document.activeElement===$('searchInput')){$('searchInput').value='';state.filters.search='';renderContent();}});


