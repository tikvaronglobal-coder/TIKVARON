# Paperclip release pin. Update deliberately after reviewing release notes.
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:v2026.1117.0

# Local-only binding; leave at 127.0.0.1 for the first installation.
PAPERCLIP_BIND_ADDRESS=127.0.0.1
PAPERCLIP_PORT=3100
PAPERCLIP_DATA_DIR=./data
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Authenticated private deployment. Do not switch to public exposure without
# HTTPS, explicit public URL, network controls, and a security review.
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# The install script generates independent random values for these two secrets.
BETTER_AUTH_SECRET=REPLACE_DURING_INSTALL
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=REPLACE_DURING_INSTALL

# Optional model-provider credentials. Keep blank until you deliberately connect
# a provider. Never commit real keys or paste them into source code.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
