 'p-qstp':{country:'Qatar',website:'https://qstp.org.qa/',contactEmail:'accelerator@qstp.org.qa; hala@qstp.qa',messageRef:'1a1e618f987b57f0; 1a1e6190344a8f33',lastContact:'2026-11-16'},
 'p-alibaba-hk':{country:'Hong Kong SAR, China',website:'https://www.ent-fund.org/',contactEmail:'enquiry-hk@ent-fund.org',messageRef:'1a1e6190c23d7da5',lastContact:'2026-11-16'},
