};
function loadPartners(){
 const defaults=initialPartnerRecords();
 try{const raw=safeStorage.getItem(PARTNER_KEY);const saved=raw?JSON.parse(raw):[];partnerRecords=Array.isArray(saved)?saved:[];}catch(e){partnerRecords=[];}
 const known=new Set(partnerRecords.map(r=>r&&r.id).filter(Boolean));
 defaults.forEach(record=>{const existing=partnerRecords.find(r=>r&&r.id===record.id);if(!existing)partnerRecords.push(record);else{for(const [key,value] of Object.entries(record)){if(existing[key]===undefined||existing[key]===null||existing[key]==='')existing[key]=value;}}});
 partnerRecords.forEach(record=>{const verified=PARTNER_VERIFICATION[record.id];if(verified){Object.entries(verified).forEach(([key,value])=>{if(!record[key]||record[key]==='Not recorded')record[key]=value;});}});
 const researched={
  'p-naver':{country:'South Korea',website:'https://d2sf.naver.com/'},
  'p-hub71':{country:'United Arab Emirates',website:'https://www.hub71.com/'},
  'p-ithca':{country:'Oman',website:'https://ithca.om/'},
  'p-silal':{country:'United Arab Emirates',website:'https://www.silal.ae/'},
  'p-hope-bahrain':{country:'Bahrain',website:'https://hopefund.bh/'},
  'p-russia-screen':{country:'Russia / cross-border risk screen',website:'Not applicable — no counterparty selected'}
 };
 partnerRecords.forEach(record=>{const r=researched[record.id];if(r)Object.entries(r).forEach(([key,value])=>{if(!record[key])record[key]=value;});});
 savePartners();
}
function savePartners(){try{safeStorage.setItem(PARTNER_KEY,JSON.stringify(partnerRecords));}catch(e){showToast('Could not save partnership register in this browser. Export a backup.');}}
function renderPartners(){const q=($('partnerFilter')?.value||'').toLowerCase();const st=$('partnerStatusFilter')?.value||'';const rows=partnerRecords.filter(r=>(!st||r.status===st)&&(!q||[r.name,r.type,r.status,r.value,r.ask,r.terms,r.evidence,r.next,r.notes,r.country,r.contactEmail,r.website,r.messageRef,r.riskMitigation].join(' ').toLowerCase().includes(q)));
const sent=partnerRecords.filter(r=>String(r.status||'').startsWith('Inquiry sent')).length;const approved=partnerRecords.filter(r=>['Approved — not yet active','Active'].includes(r.status)).length;const held=partnerRecords.filter(r=>r.status==='On hold').length;const proposed=partnerRecords.filter(r=>r.status==='Proposed — not contacted').length;
$('partnerStats').innerHTML=`<div class="ops-kpi"><b>${partnerRecords.length}</b><span>Total records</span></div><div class="ops-kpi"><b>${sent}</b><span>Inquiry sent</span></div><div class="ops-kpi"><b>${proposed}</b><span>Research only</span></div><div class="ops-kpi"><b>${held}</b><span>On hold</span></div><div class="ops-kpi"><b>${approved}</b><span>Approved / active</span></div>`;
$('partnerRegister').innerHTML=rows.length?`<table class="partner-table"><thead><tr><th>Organisation</th><th>Relationship</th><th>Status</th><th>Risk</th><th>Next action</th><th>Controls</th></tr></thead><tbody>${rows.map(r=>`<tr><td><strong>${taskEsc(r.name)}</strong><div class="score-line">Country: ${taskEsc(r.country||'Not verified')}</div><div class="score-line">${taskEsc(r.evidence||'')}</div><div class="score-line">Value: ${taskEsc(r.value||'')}</div><div class="score-line">Terms: ${taskEsc(r.terms||'')}</div><div class="score-line">Contact: ${taskEsc(r.contactEmail||'Not recorded')} · Message ref: ${taskEsc(r.messageRef||'Not recorded')}</div><div class="score-line">Website: ${taskEsc(r.website||'Not recorded')} · Last contact: ${taskEsc(r.lastContact||'Not recorded')}</div></td><td>${taskEsc(r.type)}<div class="score-line">Evaluation: ${Number.isInteger(r.score)?r.score+'/35':'Not scored'}</div></td><td><span class="partner-status">${taskEsc(r.status)}</span></td><td>${taskEsc(r.risk)}<div class="score-line">Likelihood: ${taskEsc(r.riskLikelihood||'Not assessed')} · Impact: ${taskEsc(r.riskImpact||'Not assessed')}</div><div class="score-line">Owner: ${taskEsc(r.riskOwner||'Unassigned')} · Review: ${taskEsc(r.riskReviewDate||'Not set')}</div><div class="score-line">Control: ${taskEsc(r.riskMitigation||'Not recorded')}</div></td><td>${taskEsc(r.next||'—')}<div class="score-line">${taskEsc(r.notes||'')}</div></td><td><div class="score-line">Founder approval: ${r.founderApproved?'Recorded':'No'} · Legal review: ${r.legalReviewed?'Recorded':'No'} · Signed: ${r.signed?'Recorded':'No'}</div><div class="score-line">Approval: ${taskEsc(r.approvalEvidence||'Not recorded')} · Legal: ${taskEsc(r.legalEvidence||'Not recorded')} · Agreement: ${taskEsc(r.agreementRef||'Not recorded')}</div><button class="btn small" data-partner-edit="${taskEsc(r.id)}" type="button">Edit</button> <button class="btn small" data-partner-reject="${taskEsc(r.id)}" type="button">Mark rejected</button></td></tr>`).join('')}</tbody></table>`:'<div class="empty"><strong>No matching partnership records</strong>Use the form above to add a proposed relationship.</div>';
}
function resetPartnerForm(){partnerEditingId=null;$('partnerForm').querySelector('button[type=submit]').textContent='Add partnership record';let cancel=$('partnerCancelEdit');if(cancel)cancel.remove();['partnerName','partnerValue','partnerAsk','partnerTerms','partnerEvidence','partnerNext','partnerNotes','partnerScore','partnerApprovalEvidence','partnerLegalEvidence','partnerAgreementRef','partnerRiskLikelihood','partnerRiskImpact','partnerRiskOwner','partnerRiskReviewDate','partnerRiskMitigation','partnerCountry','partnerWebsite','partnerContactEmail','partnerMessageRef','partnerLastContact'].forEach(id=>$(id).value='');$('partnerType').value='Commercial sponsor';$('partnerStatus').value='Proposed — not contacted';$('partnerRisk').value='Unassessed';['partnerFounderApproved','partnerLegalReviewed','partnerSigned'].forEach(id=>$(id).checked=false);}
function addPartner(e){
 e.preventDefault();
 const status=$('partnerStatus').value,risk=$('partnerRisk').value;
 const fa=$('partnerFounderApproved').checked,lr=$('partnerLegalReviewed').checked,sg=$('partnerSigned').checked;
 const scoreRaw=$('partnerScore').value.trim(),score=scoreRaw===''?null:Number(scoreRaw);
 const approvalEvidence=$('partnerApprovalEvidence').value.trim(),legalEvidence=$('partnerLegalEvidence').value.trim(),agreementRef=$('partnerAgreementRef').value.trim();
 const approved=['Approved — not yet active','Active'].includes(status);
 if(score!==null&&(!Number.isInteger(score)||score<0||score>35)){showToast('Evaluation score must be a whole number from 0 to 35.');return;}
 if(risk==='Critical'&&approved){showToast('Approval blocked: Critical risk must be resolved and reassessed before approval or activation.');return;}
 if(approved&&(!fa||!lr||!approvalEvidence||!legalEvidence)){showToast('Approval blocked: record founder approval evidence and completed legal-review evidence first.');return;}
 if(status==='Active'&&(!sg||!agreementRef)){showToast('Activation blocked: record that the final agreement is signed and provide its document reference.');return;}
 const previous=partnerEditingId?partnerRecords.find(x=>x.id===partnerEditingId):null;
 const record={...(previous||{}),id:partnerEditingId||'p-'+Date.now().toString(36),name:$('partnerName').value.trim(),type:$('partnerType').value,status,risk,score,value:$('partnerValue').value.trim(),ask:$('partnerAsk').value.trim(),terms:$('partnerTerms').value.trim(),evidence:$('partnerEvidence').value.trim(),next:$('partnerNext').value.trim(),notes:$('partnerNotes').value.trim(),riskLikelihood:$('partnerRiskLikelihood').value,riskImpact:$('partnerRiskImpact').value,riskOwner:$('partnerRiskOwner').value.trim(),riskReviewDate:$('partnerRiskReviewDate').value,riskMitigation:$('partnerRiskMitigation').value.trim(),country:$('partnerCountry').value.trim(),website:$('partnerWebsite').value.trim(),contactEmail:$('partnerContactEmail').value.trim(),messageRef:$('partnerMessageRef').value.trim(),lastContact:$('partnerLastContact').value,founderApproved:fa,legalReviewed:lr,signed:sg,approvalEvidence,legalEvidence,agreementRef,updatedAt:new Date().toISOString(),createdAt:previous?.createdAt||new Date().toISOString()};
 if(partnerEditingId){const ix=partnerRecords.findIndex(x=>x.id===partnerEditingId);if(ix>=0)partnerRecords[ix]=record;}
 else partnerRecords.unshift(record);
 savePartners();resetPartnerForm();renderPartners();showToast('Partnership record saved locally. No agreement or external action was taken.');
}
function editPartner(id){const r=partnerRecords.find(x=>x.id===id);if(!r)return;partnerEditingId=id;$('partnerName').value=r.name;$('partnerType').value=r.type;$('partnerStatus').value=r.status;$('partnerRisk').value=r.risk;$('partnerValue').value=r.value||'';$('partnerAsk').value=r.ask||'';$('partnerTerms').value=r.terms||'';$('partnerEvidence').value=r.evidence||'';$('partnerNext').value=r.next||'';$('partnerNotes').value=r.notes||'';$('partnerScore').value=r.score??'';$('partnerRiskLikelihood').value=r.riskLikelihood||'';$('partnerRiskImpact').value=r.riskImpact||'';$('partnerRiskOwner').value=r.riskOwner||'';$('partnerRiskReviewDate').value=r.riskReviewDate||'';$('partnerRiskMitigation').value=r.riskMitigation||'';$('partnerCountry').value=r.country||'';$('partnerWebsite').value=r.website||'';$('partnerContactEmail').value=r.contactEmail||'';$('partnerMessageRef').value=r.messageRef||'';$('partnerLastContact').value=r.lastContact||'';$('partnerApprovalEvidence').value=r.approvalEvidence||'';$('partnerLegalEvidence').value=r.legalEvidence||'';$('partnerAgreementRef').value=r.agreementRef||'';$('partnerFounderApproved').checked=!!r.founderApproved;$('partnerLegalReviewed').checked=!!r.legalReviewed;$('partnerSigned').checked=!!r.signed;$('partnerForm').querySelector('button[type=submit]').textContent='Save partnership changes';if(!$('partnerCancelEdit')){const b=document.createElement('button');b.type='button';b.id='partnerCancelEdit';b.className='btn';b.textContent='Cancel editing';b.addEventListener('click',resetPartnerForm);$('partnerForm').querySelector('div.wide').appendChild(b);} $('partnerForm').scrollIntoView({behavior:'smooth',block:'start'});}
function rejectPartner(id){const r=partnerRecords.find(x=>x.id===id);if(!r)return;if(!confirm('Mark '+r.name+' as rejected? This records a decision only; it does not send a message.'))return;r.status='Rejected';savePartners();renderPartners();}
function exportPartners(){const headers=['Organisation','Relationship type','Status','Risk','Evaluation score / 35','Value offered','Requested from TIKVARON','Ownership/IP/data terms','Evidence','Next action','Due-diligence notes','Risk likelihood','Risk impact','Risk owner','Risk review date','Risk mitigation','Country','Official website','Official contact email','Outreach message reference','Last contact date','Founder approved','Founder approval evidence','Legal reviewed','Legal review evidence','Agreement signed','Signed agreement reference','Created at','Updated at'];const csv=v=>{let x=String(v??'');if(/^[\s]*[=+@-]/.test(x))x="'"+x;return '"'+x.replace(/"/g,'""')+'"';};const rows=[headers.map(csv).join(',')];partnerRecords.forEach(r=>rows.push([r.name,r.type,r.status,r.risk,r.score,r.value,r.ask,r.terms,r.evidence,r.next,r.notes,r.riskLikelihood,r.riskImpact,r.riskOwner,r.riskReviewDate,r.riskMitigation,r.country,r.website,r.contactEmail,r.messageRef,r.lastContact,r.founderApproved,r.approvalEvidence,r.legalReviewed,r.legalEvidence,r.signed,r.agreementRef,r.createdAt,r.updatedAt].map(csv).join(',')));downloadFile('\ufeff'+rows.join('\r\n'),'tikvaron-partnership-register.csv','text/csv;charset=utf-8');}
function backupPartners(){downloadFile(JSON.stringify({format:'TIKVARON_PARTNERSHIP_GOVERNANCE',version:2,exportedAt:new Date().toISOString(),records:partnerRecords},null,2),'tikvaron-partnership-governance-backup.json','application/json');}
function importPartnerBackup(file){const reader=new FileReader();reader.onload=()=>{try{const data=JSON.parse(reader.result);if(data.format!=='TIKVARON_PARTNERSHIP_GOVERNANCE'||![1,2].includes(data.version)||!Array.isArray(data.records))throw new Error('Unrecognised backup format.');const clean=data.records.filter(r=>r&&typeof r.id==='string'&&typeof r.name==='string'&&r.name.trim()).map(r=>({...r,score:Number.isInteger(r.score)&&r.score>=0&&r.score<=35?r.score:null,founderApproved:!!r.founderApproved,legalReviewed:!!r.legalReviewed,signed:!!r.signed}));if(clean.length!==data.records.length)throw new Error('Backup contains invalid records. Nothing was imported.');if(!confirm('Restore '+clean.length+' partnership records? This replaces the current local partnership register. Export a backup first if you need the current records.'))return;partnerRecords=clean;savePartners();resetPartnerForm();renderPartners();showToast('Partnership backup restored.');}catch(err){showToast('Restore failed: '+err.message);}};reader.readAsText(file);}
function initPartners(){loadPartners();renderPartners();$('partnerForm').addEventListener('submit',addPartner);$('partnerFilter').addEventListener('input',renderPartners);$('partnerStatusFilter').addEventListener('change',renderPartners);$('partnerRegister').addEventListener('click',e=>{const ed=e.target.closest('[data-partner-edit]');const re=e.target.closest('[data-partner-reject]');if(ed)editPartner(ed.dataset.partnerEdit);if(re)rejectPartner(re.dataset.partnerReject);});$('partnerExportCsv').addEventListener('click',exportPartners);$('partnerBackupBtn').addEventListener('click',backupPartners);$('partnerRestoreBtn').addEventListener('click',()=>$('partnerRestoreFile').click());$('partnerRestoreFile').addEventListener('change',e=>{if(e.target.files&&e.target.files[0])importPartnerBackup(e.target.files[0]);e.target.value='';});}

function switchView(view){const views={systems:'systemsView',sponsors:'sponsorView',operations:'operationsView',partnerships:'partnershipsView'};Object.entries(views).forEach(([key,id])=>$(id).hidden=key!==view);document.querySelectorAll('[data-view]').forEach(btn=>btn.classList.toggle('active',btn.dataset.view===view));if(view==='sponsors')renderSponsorGate();if(view==='operations')renderOps();if(view==='partnerships')renderPartners();}
function initOps(){loadOps();renderOps();$('addActionForm').addEventListener('submit',addAction);$('opsTaskList').addEventListener('change',e=>{const el=e.target.closest('[data-task-field]');if(el)opsUpdate(el.dataset.taskId,el.dataset.taskField,el.value);});$('opsTaskList').addEventListener('click',e=>{const btn=e.target.closest('[data-delete-task]');if(btn){opsTasks=opsTasks.filter(t=>t.id!==btn.dataset.deleteTask);saveOps();renderOps();}});$('opsExportCsv').addEventListener('click',exportOpsCSV);$('opsBackupBtn').addEventListener('click',exportOpsBackup);['calcFarmers','calcWeeks','calcSetup','calcAiUnit','calcMsgUnit','calcAgroMonthly','calcSupportMonthly','calcField','calcOther','calcContingency','calcMargin'].forEach(id=>$(id).addEventListener('input',calc));$('calcReset').addEventListener('click',clearCalc);$('systemModalClose').addEventListener('click',closeSystemManager);$('systemModalCancel').addEventListener('click',closeSystemManager);$('systemModalForm').addEventListener('submit',saveSystemManager);$('systemModal').addEventListener('click',e=>{if(e.target===$('systemModal'))closeSystemManager();});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('systemModal').hidden)closeSystemManager();});}


// Start-up: show actionable diagnostics instead of silently failing with a blank view.
function showStartupFailure(error) {
  const message = error && error.message ? error.message : String(error || 'Unknown startup error');
  let panel = document.getElementById('startupError');
  if (!panel) {
    panel = document.createElement('section');
    panel.id = 'startupError';
    panel.setAttribute('role', 'alert');
    panel.style.cssText = 'margin:16px auto;padding:14px 16px;max-width:1100px;border:1px solid #e8756d;border-radius:12px;background:#2a1715;color:#ffe7e3;font:13px/1.5 system-ui,sans-serif;';
    const main = document.querySelector('main') || document.body;
    main.prepend(panel);
  }
  panel.innerHTML = '<strong>TIKVARON CBOS could not finish starting.</strong><p style="margin:6px 0">The page is still open. Copy this diagnostic when requesting support:</p><code style="white-space:pre-wrap;overflow-wrap:anywhere"></code>';
  panel.querySelector('code').textContent = message;
}
window.addEventListener('error', event => {
  if (event && event.error) showStartupFailure(event.error);
});
window.addEventListener('unhandledrejection', event => {
  showStartupFailure(event && event.reason ? event.reason : 'Unhandled asynchronous error');
});
try {
  loadState();
  fillStageFilters();
  renderSidebar();
  render();
  initSponsorGate();
  initOps();
  initPartners();
  if (!safeStorage.persistent) {
    const status = document.getElementById('storageState');
    if (status) {
      status.textContent = '! Temporary browser memory — export backups';
      status.classList.add('warn');
      status.title = 'This browser context blocks persistent local storage. Export JSON backups before closing or refreshing.';
    }
  }
} catch (startupError) {
  showStartupFailure(startupError);
}
</script>
</body>
</html>