nya network','https://fipsafrica.org/'],['FIPS donor partnerships','https://fipsafrica.org/partnership/donors/'],['FIPS leadership','https://fipsafrica.org/our-team/'],['FIPS partnership page','https://fipsafrica.org/partnership/']]},
 {id:'samunnati',name:'Samunnati',country:'India',qualification:'Medium',scores:{farmerAccess:2,programmeFit:2,decisionAccess:2,budgetRoute:1,paidIntent:0},headline:'Strong institutional innovation/channel candidate; distinguish collaboration from actual paid procurement.',roles:'MD & CEO Diwakar Ram Boddupalli; Group CTO / technology leadership Suresh Rajagopalan; Innovation and Research or Strategic Partnerships team; FPO business leadership.',contact:'info@samunnati.com · +91 97908 97000 · official enquiry form; Chennai registered office.',budget:'Samunnati publicly invites startups to collaborate and pilot/scale agri-tech innovations. FPO Next bundles trade, finance and advisory. This supports a credible innovation/partnership route, but no current budget amount or FarmVoice purchase authorization is public.',cohort:'100–150 farmers through one or two participating FPOs, with the crop chosen from the selected FPOs’ actual value chain and local-language requirements.',pilot:'12-week FPO-cluster pilot: voice-first advisory for up to two crops, local-language configuration, agronomist escalation and an outcome report for FPO support teams.',risk:'FPO Next already includes advisory. FarmVoice must show a distinct voice-first workflow or integration advantage; Samunnati may be a channel, integrator, partner or competitor rather than the paying customer.',next:'Founder approval needed before any contact. Prepare a product-partnership note and ask whether a startup pilot is funded, whether FPOs pay directly, and who owns procurement.',sources:[['Samunnati official site / startup collaboration','https://www.samunnati.com/'],['Samunnati team','https://www.samunnati.com/profile/'],['Samunnati contact','https://samunnati.com/contact-us/'],['Samunnati annual report','https://samunnati.com/wp-content/uploads/2026/01/Annual-Report-FY-23-24.pdf']]},
 {id:'ched',name:'COCOBOD / Cocoa Health and Extension Division (CHED)',country:'Ghana',qualification:'Medium',scores:{farmerAccess:2,programmeFit:2,decisionAccess:2,budgetRoute:1,paidIntent:0},headline:'Clear cocoa-extension use case and named budget/IT roles; current COCOBOD financial pressure is a serious constraint.',roles:'Dr Richard Adu-Acheampong, Executive Director; Mrs Margaret Frimpong Ayerakwa, Deputy Executive Director (Extension); Mrs Yvonne Nana Oye Essuon, Deputy Director Finance; Mr Ernest Ayivor, Information Systems Manager.',contact:'info@ched.com.gh · +233 302 666 946 · CHED contact and regional offices.',budget:'CHED has a cocoa extension public-private partnership and names active institutional partners including GIZ and World Cocoa Foundation. However, current COCOBOD liquidity/restructuring pressures make discretionary procurement uncertain. The Ghana Feed Ghana Farmer Service Centre allocation is not evidence of a CHED FarmVoice budget.',cohort:'100–150 cocoa farmers in one cocoa-growing region, selected with CHED regional extension leadership. Cocoa only; no multi-crop expansion in the initial pilot.',pilot:'12-week cocoa extension pilot for routine approved farm-practice information and voice access. Disease, chemical or treatment uncertainty must be escalated to CHED staff; do not automate unverified diagnosis or dosage advice.',risk:'Government/COCOBOD procurement and content approvals may be slow. COCOBOD financial restructuring creates budget risk; require confirmation of an eligible current budget line before proposal.',next:'Founder approval needed before any contact. First establish whether CHED can sponsor or whether a cocoa-sector partner/donor must fund a paid innovation pilot.',sources:[['CHED profile and farmer reach','https://www.ched.com.gh/about'],['CHED management','https://ched.com.gh/management'],['CHED partnerships','https://ched.com.gh/partnership'],['CHED extension model','https://ched.com.gh/website/departments.html'],['IMF Ghana cocoa-sector financial context','https://www.elibrary.imf.org/view/journals/002/2026/212/article-A001-en.xml']]},
 {id:'babban-gona',name:'Babban Gona',country:'Nigeria',qualification:'Low',scores:{farmerAccess:2,programmeFit:1,decisionAccess:2,budgetRoute:0,paidIntent:0},headline:'Large farmer-service platform, but weaker as a first-time buyer because it already operates technology and the public accelerator window has closed.',roles:'Kola Masha, Managing Director; farmer services/operations leadership; technology platform and partnerships leadership.',contact:'Official website contact route; Lagos office at 15A Sowemimo Street, Ikeja GRA. Use the website form rather than guessing an email address.',budget:'The 2026 Impact Accelerator Fellowship advertised up to US$250,000 per qualifying agro-processor to build a farmer ecosystem, but the published application deadline was 15 September 2026 and has passed. This grant is not a FarmVoice vendor budget. No open direct procurement route for FarmVoice was verified.',cohort:'A defined 100–150 farmer group from a current network or one participating processor. Commodity should match the selected farmer ecosystem; maize is only a hypothesis pending confirmation.',pilot:'Potential integration or add-on test within an existing farmer network, only if Babban Gona identifies a gap not already covered by its platform and agrees to pay for an external service.',risk:'Existing technology platform may overlap with FarmVoice. The accelerator grant supports processors’ farmer-ecosystem costs and should not be presented as money available to TIKVARON. Current intake is closed pending a later cycle.',next:'Founder approval needed before any contact. Keep as a channel/integration prospect unless it identifies a specific advisory gap and paid budget route.',sources:[['Babban Gona official site','https://babbangona.com/'],['Babban Gona leadership','https://babbangona.com/leadership/'],['Impact Accelerator Fellowship and expired deadline','https://babbangona.com/accelerator/'],['Babban Gona latest news','https://babbangona.com/news/']]}
];
let sponsorEdits={};
const $s=id=>document.getElementById(id);
function loadSponsorEdits(){try{const raw=safeStorage.getItem(SPONSOR_STORAGE_KEY);if(raw){const o=JSON.parse(raw);if(o&&o.version===1&&o.edits&&typeof o.edits==='object')sponsorEdits=o.edits;}}catch(e){}const cga=sponsorEdits.cga;if(cga&&cga.stage==='Research complete — not contacted')cga.stage='Discovery inquiry sent — awaiting response';if(cga&&!String(cga.notes||'').includes('16 Nov 2026: Non-binding paid-pilot discovery inquiry sent')){const log='16 Nov 2026: Non-binding paid-pilot discovery inquiry sent from TIKVARON Gmail to info@cga.co.ke. Subject: Exploring a paid, limited FarmVoice pilot with CGA. Status: sent; awaiting response. No paid commitment verified.';cga.notes=(cga.notes?cga.notes+'\n\n':'')+log;}if(cga&&(!cga.nextAction||cga.nextAction.startsWith('Founder approval needed before any contact'))){cga.nextAction='Await CGA acknowledgement. If acknowledged, request an introduction to the programme / Farmer Service Centre digitisation and budget owner; then qualify current budget, procurement route, agronomy approval and a feasible farmer cohort.';}if(cga)saveSponsorEdits();}
function saveSponsorEdits(){try{safeStorage.setItem(SPONSOR_STORAGE_KEY,JSON.stringify({version:1,edits:sponsorEdits}));if($s('storageState'))$s('storageState').textContent='● Local edits saved';}catch(e){if($s('storageState')){$s('storageState').textContent='● Storage unavailable — export backup';$s('storageState').classList.add('warn');}}}
function se(id){return sponsorEdits[id]||(sponsorEdits[id]={});}
function sv(p,k){const e=sponsorEdits[p.id]||{};return e[k]!==undefined?e[k]:(p[k]!==undefined?p[k]:'');}
function sponsorScore(p){const base=p.scores||{};const e=sponsorEdits[p.id]||{};return SPONSOR_RUBRIC.reduce((sum,[key])=>sum+Number(e['rubric_'+key]!==undefined?e['rubric_'+key]:(base[key]||0)),0);}
function sponsorStageOptions(selected){return SPONSOR_STAGES.map(x=>`<option value="${esc(x)}" ${selected===x?'selected':''}>${esc(x)}</option>`).join('');}
function rubricControls(p){return SPONSOR_RUBRIC.map(([key,label])=>{const base=(p.scores||{})[key]||0;const value=(sponsorEdits[p.id]||{})['rubric_'+key]!==undefined?sponsorEdits[p.id]['rubric_'+key]:base;return `<label>${esc(label)}<select data-sponsor-field="rubric_${key}" data-sponsor-id="${p.id}"><option value="0" ${Number(value)===0?'selected':''}>0 · Not evidenced</option><option value="1" ${Number(value)===1?'selected':''}>1 · Partial / plausible</option><option value="2" ${Number(value)===2?'selected':''}>2 · Strong public evidence</option></select></label>`;}).join('');}
function renderSponsorGate(){
 const search=($s('prospectSearch')?.value||'').toLowerCase().trim();const country=$s('prospectCountry')?.value||'';const stage=$s('prospectStage')?.value||'';const qual=$s('prospectQualification')?.value||'';const ownerFilter=$s('prospectOwner')?.value||'';
 const list=SPONSORS.filter(p=>{const owner=sv(p,'owner');const st=sv(p,'stage')||SPONSOR_STAGES[0];const q=sv(p,'qualification')||p.qualification;const hay=[p.name,p.country,p.roles,p.contact,p.budget,p.pilot,p.risk,p.next].join(' ').toLowerCase();return (!search||hay.includes(search))&&(!country||p.country===country)&&(!stage||st===stage)&&(!qual||q===qual)&&(!ownerFilter||(ownerFilter==='assigned'?!!owner.trim():!owner.trim()));});
 $s('sponsorTotal').textContent=SPONSORS.length;$s('sponsorHigh').textContent=SPONSORS.filter(p=>sv(p,'qualification')==='High'||(!sv(p,'qualification')&&p.qualification==='High')).length;
 $s('sponsorBudget').textContent=SPONSORS.filter(p=>['Budget route validated','Pilot scope agreed','Paid proposal submitted','Written sponsor intent','Paid pilot approved / PO'].includes(sv(p,'stage'))).length;
 $s('sponsorPaid').textContent=SPONSORS.filter(p=>sv(p,'stage')==='Paid pilot approved / PO').length;
 if(!$s('prospectCards'))return;
 if(!list.length){$s('prospectCards').innerHTML='<div class="sponsor-empty">No matching sponsor prospects. Adjust the filters.</div>';return;}
 $s('prospectCards').innerHTML=list.map(p=>{
   const rating=sv(p,'qualification')||p.qualification;const stageValue=sv(p,'stage')||SPONSOR_STAGES[0];const score=sponsorScore(p);const owner=sv(p,'owner');const rank=SPONSORS.findIndex(x=>x.id===p.id)+1;const next=sv(p,'nextAction')||p.next;const notes=sv(p,'notes')||'';const sponsorStatus=sv(p,'sponsorStatus')||'No commitment verified';
   const links=p.sources.map(([label,url])=>`<a href="${url}" target="_blank" rel="noopener noreferrer">${esc(label)}</a>`).join(' · ');
   return `<article class="prospect-card" data-prospect="${p.id}">
    <div class="prospect-head"><div><div class="prospect-country">PRIORITY ${rank} · ${esc(p.country)}</div><h4>${esc(p.name)}</h4></div><span class="qualification q-${rating.toLowerCase()}">${esc(rating)} qualification</span></div>
    <p class="evidence-note">${esc(p.headline)}</p>
    <div class="score-wrap"><span class="score-number">${score}/10</span><span class="score-caption">public evidence readiness<br>not buying probability</span><div class="score-track"><div class="score-fill" style="width:${score*10}%"></div></div></div>
    <div class="prospect-fields">
      <label>Deal stage<select data-sponsor-field="stage" data-sponsor-id="${p.id}">${sponsorStageOptions(stageValue)}</select></label>
      <label>Qualification<select data-sponsor-field="qualification" data-sponsor-id="${p.id}"><option ${rating==='High'?'selected':''}>High</option><option ${rating==='Medium'?'selected':''}>Medium</option><option ${rating==='Low'?'selected':''}>Low</option></select></label>
      <label>Accountable owner<input data-sponsor-field="owner" data-sponsor-id="${p.id}" maxlength="80" value="${esc(owner)}" placeholder="Unassigned"></label>
      <label>Sponsor evidence<select data-sponsor-field="sponsorStatus" data-sponsor-id="${p.id}">${['No commitment verified','Verbal interest only','Written indication','Paid pilot agreement / PO','Payment received'].map(x=>`<option ${sponsorStatus===x?'selected':''}>${x}</option>`).join('')}</select></label>
      <label>Next action<textarea data-sponsor-field="nextAction" data-sponsor-id="${p.id}" maxlength="500">${esc(next)}</textarea></label>
      <label>Research / meeting notes<textarea data-sponsor-field="notes" data-sponsor-id="${p.id}" maxlength="2000" placeholder="Record verified evidence and date; do not store confidential farmer data.">${esc(notes)}</textarea></label>
    </div>
    <details><summary>Qualification evidence, contact route and pilot design</summary>
      <div class="detail-block"><strong>Relevant decision roles</strong><p>${esc(p.roles)}</p></div>
      <div class="detail-block"><strong>Public contact route</strong><p>${esc(p.contact)}</p></div>
      <div class="detail-block"><strong>Current programme / funding evidence</strong><p>${esc(p.budget)}</p></div>
      <div class="detail-block"><strong>Potential farmer cohort</strong><p>${esc(p.cohort)}</p></div>
      <div class="detail-block"><strong>Paid-pilot proposition</strong><p>${esc(p.pilot)}</p></div>
      <div class="detail-block"><strong>Key qualification risk</strong><p>${esc(p.risk)}</p></div>
      <div class="detail-block"><strong>Recommended next step</strong><p>${esc(p.next)}</p></div>
      <div class="rubric-title">Evidence score rubric · edit only when evidence changes</div><div class="rubric-grid">${rubricControls(p)}</div>
      <div class="detail-block"><strong>Sources</strong><p>${links}</p></div>
    </details>
   </article>`;
 }).join('');
}
function updateSponsorField(id,field,value){const row=se(id);if(field.startsWith('rubric_')){const n=Number(value);if(Number.isInteger(n)&&n>=0&&n<=2)row[field]=n;}else if(field==='qualification'){if(['High','Medium','Low'].includes(value))row[field]=value;}else if(field==='stage'){if(SPONSOR_STAGES.includes(value))row[field]=value;}else if(field==='sponsorStatus'){if(['No commitment verified','Verbal interest only','Written indication','Paid pilot agreement / PO','Payment received'].includes(value))row[field]=value;}else if(['owner','nextAction','notes'].includes(field)){row[field]=String(value).slice(0,field==='notes'?2000:500).trim();}saveSponsorEdits();}
function exportSponsorCSV(){const headers=['Organisation','Country','Qualification','Evidence Readiness Score / 10','Deal Stage','Sponsor Evidence','Owner','Farmer Access Score','Programme Fit Score','Decision-maker Access Score','Budget Route Score','Paid Intent Score','Decision Roles','Public Contact','Budget Evidence / Route','Farmer Cohort','Paid Pilot Proposition','Key Risk','Next Action','Notes'];const csv=v=>{let x=String(v??'');if(/^[\s]*[=+@-]/.test(x))x="'"+x;return '"'+x.replace(/"/g,'""')+'"';};const lines=[headers.map(csv).join(',')];SPONSORS.forEach(p=>{const e=sponsorEdits[p.id]||{};const rubric=SPONSOR_RUBRIC.map(([k])=>Number(e['rubric_'+k]!==undefined?e['rubric_'+k]:(p.scores||{})[k]||0));lines.push([p.name,p.country,e.qualification||p.qualification,sponsorScore(p),e.stage||SPONSOR_STAGES[0],e.sponsorStatus||'No commitment verified',e.owner||'',...rubric,p.roles,p.contact,p.budget,p.cohort,p.pilot,p.risk,e.nextAction||p.next,e.notes||''].map(csv).join(','));});downloadFile('\ufeff'+lines.join('\r\n'),'tikvaron-farmvoice-sponsor-validation.csv','text/csv;charset=utf-8');showToast('Sponsor CSV exported: '+SPONSORS.length+' prospects');}
function exportSponsorBackup(){downloadFile(JSON.stringify({format:'TIKVARON_FARMVOICE_SPONSOR_GATE',version:1,exportedAt:new Date().toISOString(),edits:sponsorEdits},null,2),'tikvaron-farmvoice-sponsor-backup.json','application/json');showToast('Sponsor tracker backup downloaded.');}
function importSponsorBackup(file){const reader=new FileReader();reader.onload=()=>{try{const o=JSON.parse(reader.result);if(o.format!=='TIKVARON_FARMVOICE_SPONSOR_GATE'||o.version!==1||!o.edits||typeof o.edits!=='object')throw new Error('This is not a recognised FarmVoice sponsor backup.');const allowed=new Set(SPONSORS.map(p=>p.id));const clean={};for(const [id,fields] of Object.entries(o.edits)){if(!allowed.has(id)||!fields||typeof fields!=='object')continue;const row={};for(const key of ['owner','nextAction','notes'])if(typeof fields[key]==='string')row[key]=fields[key].slice(0,key==='notes'?2000:500);if(['High','Medium','Low'].includes(fields.qualification))row.qualification=fields.qualification;if(SPONSOR_STAGES.includes(fields.stage))row.stage=fields.stage;if(['No commitment verified','Verbal interest only','Written indication','Paid pilot agreement / PO','Payment received'].includes(fields.sponsorStatus))row.sponsorStatus=fields.sponsorStatus;for(const [rk] of SPONSOR_RUBRIC){const v=fields['rubric_'+rk];if(Number.isInteger(v)&&v>=0&&v<=2)row['rubric_'+rk]=v;}if(Object.keys(row).length)clean[id]=row;}sponsorEdits=clean;saveSponsorEdits();renderSponsorGate();showToast('Sponsor tracker restored.');}catch(err){showToast(err.message||'Could not restore sponsor backup.');}$s('prospectRestoreFile').value='';};reader.readAsText(file);}
/* switchView is defined in the operating cockpit block below. */
function initSponsorGate(){
 loadSponsorEdits();
 $s('prospectStage').innerHTML='<option value="">All deal stages</option>'+SPONSOR_STAGES.map(x=>`<option>${esc(x)}</option>`).join('');
 document.querySelectorAll('[data-view]').forEach(btn=>btn.addEventListener('click',()=>switchView(btn.dataset.view)));
 ['prospectSearch','prospectCountry','prospectStage','prospectQualification','prospectOwner'].forEach(id=>$s(id).addEventListener(id==='prospectSearch'?'input':'change',renderSponsorGate));
 $s('prospectCards').addEventListener('change',e=>{const el=e.target.closest('[data-sponsor-field]');if(el)updateSponsorField(el.dataset.sponsorId,el.dataset.sponsorField,el.value);renderSponsorGate();});
 $s('prospectCards').addEventListener('input',e=>{const el=e.target.closest('input[data-sponsor-field],textarea[data-sponsor-field]');if(el)updateSponsorField(el.dataset.sponsorId,el.dataset.sponsorField,el.value);});
 $s('prospectReset').addEventListener('click',()=>{['prospectSearch','prospectCountry','prospectStage','prospectQualification','prospectOwner'].forEach((id)=>$s(id).value='');renderSponsorGate();});
 $s('prospectExport').addEventListener('click',exportSponsorCSV);$s('prospectBackup').addEventListener('click',exportSponsorBackup);$s('prospectRestore').addEventListener('click',()=>$s('prospectRestoreFile').click());$s('prospectRestoreFile').addEventListener('change',e=>{if(e.target.files&&e.target.files[0])importSponsorBackup(e.target.files[0]);});
 renderSponsorGate();
}


// Operating cockpit: actions, stage gates and editable FarmVoice cost model.
const OPS_STORAGE_KEY='tikvaron.cbos.operating-cockpit.v1';
const OPS_DEFAULTS=[
 {id:'cga-followup',title:'CGA sponsor discovery — qualify budget owner and procurement route',workstream:'Commercial validation',status:'Waiting',owner:'',due:'2026-11-23',notes:'Non-binding inquiry sent 16 November 2026 to info@cga.co.ke. Await response. If no acknowledgement, decide manually whether to send a polite follow-up; nothing is auto-sent.'},
 {id:'concept-note',title:'Prepare one-page FarmVoice paid-pilot concept note',workstream:'Commercial validation',status:'Not started',owner:'',due:'2026-11-19',notes:'Define problem, 100–150 farmer cohort, one geography, up to two crops, 12-week duration, agronomy escalation, measures and non-binding commercial assumptions.'},
 {id:'pilot-costs',title:'Populate FarmVoice cost-to-serve model with real quotes',workstream:'Finance & unit economics',status:'In progress',owner:'',due:'2026-11-20',notes:'Calculator is available in this dashboard. No AI, WhatsApp, agronomist, support or field costs have been supplied yet. Do not send a price until these are evidenced.'},
 {id:'agronomy-governance',title:'Identify qualified agronomy content approver and escalation cover',workstream:'Agronomy governance',status:'Not started',owner:'',due:'2026-11-20',notes:'Confirm crop expertise, approved knowledge sources, high-risk question rules, human response process and coverage arrangements before pilot advice is delivered.'},
 {id:'data-privacy',title:'Prepare pilot privacy, consent and data-handling checklist',workstream:'Legal & privacy',status:'Not started',owner:'',due:'2026-11-24',notes:'Define data collected, purpose, consent, retention, access, deletion, processor/vendor roles and incident handling. Obtain qualified legal review before launch.'},
 {id:'security-baseline',title:'Verify security baseline and credential handling',workstream:'Security',status:'Not started',owner:'',due:'2026-11-24',notes:'Check MFA, least privilege, secret storage, environment separation, backups, access log, vendor access and incident contacts. Never put keys or farmer data in this local file.'},
 {id:'weekly-review',title:'Run weekly founder operating review',workstream:'Business operations',status:'Not started',owner:'',due:'2026-11-23',notes:'Review sponsor pipeline, paid-intent evidence, actions overdue, cost-model completeness, risks and next decisions. Record decisions in the action notes.'},
 {id:'billing-accounting',title:'Select invoicing and accounting workflow for first paid pilot',workstream:'Finance & unit economics',status:'Deferred',owner:'',due:'',notes:'Defer paid accounting/billing software until there is a real sponsor and invoice requirement. Before issuing an invoice, verify entity, tax and accounting requirements with a qualified adviser.'},
 {id:'farmvoice-build-gate',title:'Full FarmVoice platform build',workstream:'Product & engineering',status:'Blocked',owner:'',due:'',notes:'Blocked until an authorised paying sponsor, written pilot scope, identified budget/procurement route, agreed payment terms, viable farmer cohort, agronomy governance and privacy/security controls are verified.'},
 {id:'support-knowledge',title:'Set up pilot support inbox, approved answers and escalation log',workstream:'Business operations',status:'Deferred',owner:'',due:'',notes:'Prepare the support workflow only after a paid pilot scope and named operational contacts are known. Existing Gmail is used for sponsor correspondence, not yet a live farmer-support desk.'}
];
let opsTasks=[];
function currentCalcValues(){const ids=['calcFarmers','calcWeeks','calcSetup','calcAiUnit','calcMsgUnit','calcAgroMonthly','calcSupportMonthly','calcField','calcOther','calcContingency','calcMargin'];const out={};ids.forEach(id=>{const el=$(id);if(el)out[id]=el.value;});return out;}
function applyCalcValues(values){if(!values||typeof values!=='object')return;Object.entries(values).forEach(([id,value])=>{const el=$(id);if(el&&typeof value==='string')el.value=value;});}
function saveOps(){try{safeStorage.setItem(OPS_STORAGE_KEY,JSON.stringify({version:1,tasks:opsTasks,calculator:currentCalcValues()}));}catch(e){$('storageState').textContent='! Backup required';$('storageState').classList.add('warn');}}
function loadOps(){try{const raw=safeStorage.getItem(OPS_STORAGE_KEY);if(raw){const parsed=JSON.parse(raw);if(parsed&&parsed.version===1&&Array.isArray(parsed.tasks)){const map=new Map(parsed.tasks.filter(t=>t&&t.id).map(t=>[t.id,t]));opsTasks=OPS_DEFAULTS.map(d=>({...d,...(map.get(d.id)||{})}));for(const t of parsed.tasks)if(t&&t.id&&!OPS_DEFAULTS.some(d=>d.id===t.id))opsTasks.push(t);applyCalcValues(parsed.calculator);return;}}}catch(e){}opsTasks=OPS_DEFAULTS.map(x=>({...x}));saveOps();}
function taskEsc(s){return esc(s);}
function renderOps(){
 const open=opsTasks.filter(t=>!['Complete','Deferred'].includes(t.status)).length;
 const blocked=opsTasks.filter(t=>['Blocked','Waiting'].includes(t.status)).length;
 const done=opsTasks.filter(t=>t.status==='Complete').length;
 $('opsOpenCount').textContent=open;$('opsBlockedCount').textContent=blocked;$('opsDoneCount').textContent=done;
 const starter=[
  ['CRM / sponsor pipeline','Active — five prospects are tracked locally; CGA inquiry has been sent.','Use sponsor gate for qualification; no automatic outreach.'],
  ['Billing / invoicing','Deferred — no paid pilot yet.','Trigger: signed paid-pilot scope and confirmed payer.'],
  ['Accounting / cash records','Pre-revenue control only; no accounting SaaS chosen.','Trigger: first revenue, tax obligations or recurring transactions.'],
  ['Support inbox + documentation','Gmail used for sponsor correspondence; farmer support desk not live.','Trigger: named pilot cohort and service responsibilities.'],
  ['Product + AI cost analytics','Cost calculator active; no delivery tariffs or usage data entered.','Track cost per farmer, request and cohort before quoting.'],
  ['Legal basics','Not yet approved for a farmer pilot.','Complete privacy, consent, terms, vendor and pilot agreement review first.'],
  ['Weekly metrics review','Operating cadence defined here; first review is a founder action.','Review pipeline, sponsor intent, costs, risk and decisions weekly.']
 ];
 $('starterGrid').innerHTML=starter.map(([name,status,trigger])=>`<article class="starter-card"><h4>${taskEsc(name)}</h4><p>${taskEsc(status)}</p><div class="starter-meta">${taskEsc(trigger)}</div></article>`).join('');
 $('opsTaskList').innerHTML=opsTasks.map(t=>`<article class="ops-task" data-task="${taskEsc(t.id)}"><div class="ops-task-top"><div><h4>${taskEsc(t.title)}</h4><small>${taskEsc(t.workstream||'Business operations')}</small></div><button type="button" class="task-delete" data-delete-task="${taskEsc(t.id)}" title="Remove action">Remove</button></div><div class="ops-task-fields"><label>Status<select data-task-field="status" data-task-id="${taskEsc(t.id)}">${['Not started','Research','Planned','In progress','Waiting','Blocked','Deferred','Complete'].map(s=>`<option ${t.status===s?'selected':''}>${s}</option>`).join('')}</select></label><label>Owner / role<input data-task-field="owner" data-task-id="${taskEsc(t.id)}" maxlength="80" value="${taskEsc(t.owner||'')}" placeholder="Unassigned"></label><label>Review / due date<input type="date" data-task-field="due" data-task-id="${taskEsc(t.id)}" value="${taskEsc(t.due||'')}"></label><label>Workstream<input data-task-field="workstream" data-task-id="${taskEsc(t.id)}" maxlength="80" value="${taskEsc(t.workstream||'')}"></label><label style="grid-column:span 2">Evidence / next step<textarea data-task-field="notes" data-task-id="${taskEsc(t.id)}" maxlength="1200">${taskEsc(t.notes||'')}</textarea></label></div></article>`).join('')||'<div class="empty"><strong>No actions yet</strong>Add the first action above.</div>';
 calc();
}
function opsUpdate(taskId,field,value){const t=opsTasks.find(x=>x.id===taskId);if(!t)return;if(field==='status'&&['Not started','Research','Planned','In progress','Waiting','Blocked','Deferred','Complete'].includes(value))t.status=value;else if(field==='due'){t.due=value;}else if(['owner','workstream','notes'].includes(field))t[field]=String(value).slice(0,field==='notes'?1200:80);saveOps();renderOps();}
function addAction(e){e.preventDefault();const title=$('newActionTitle').value.trim();if(!title)return;const id='task-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,6);opsTasks.unshift({id,title,workstream:$('newActionWorkstream').value,status:'Not started',owner:$('newActionOwner').value.trim(),due:$('newActionDue').value,notes:''});saveOps();$('addActionForm').reset();renderOps();showToast('Action added to the operating queue.');}
function exportOpsCSV(){const headers=['Action','Workstream','Status','Owner','Due date','Evidence / next step'];const csv=v=>{let x=String(v??'');if(/^[\s]*[=+@-]/.test(x))x="'"+x;return '"'+x.replace(/"/g,'""')+'"';};const rows=[headers.map(csv).join(',')];opsTasks.forEach(t=>rows.push([t.title,t.workstream,t.status,t.owner,t.due,t.notes].map(csv).join(',')));downloadFile('\ufeff'+rows.join('\r\n'),'tikvaron-operating-actions.csv','text/csv;charset=utf-8');showToast('Operating action CSV exported.');}
function exportOpsBackup(){downloadFile(JSON.stringify({format:'TIKVARON_OPERATING_COCKPIT',version:1,exportedAt:new Date().toISOString(),tasks:opsTasks,calculator:currentCalcValues()},null,2),'tikvaron-operating-cockpit-backup.json','application/json');showToast('Operating cockpit backup downloaded.');}
function calcNum(id){const s=$(id).value.trim();return s===''?null:Number(s);}
function money(n){return 'KES '+n.toLocaleString('en-KE',{minimumFractionDigits:2,maximumFractionDigits:2});}
function calc(){
 if($('calcFarmers'))saveOps();
 const required=['calcSetup','calcAiUnit','calcMsgUnit','calcAgroMonthly','calcSupportMonthly','calcField'];
 const entered=required.filter(id=>$(id).value.trim()!=='').length;
 $('opsCostReady').textContent=entered+'/6';
 $('calcReadiness').textContent=`${entered} of 6 core cost inputs entered · ${entered===6?'ready for review, not an approved quote':'not quote-ready'}`;
 const farmers=calcNum('calcFarmers'),weeks=calcNum('calcWeeks'),setup=calcNum('calcSetup'),ai=calcNum('calcAiUnit'),msg=calcNum('calcMsgUnit'),agro=calcNum('calcAgroMonthly'),support=calcNum('calcSupportMonthly'),field=calcNum('calcField'),other=calcNum('calcOther'),cont=calcNum('calcContingency'),margin=calcNum('calcMargin');
 const valid=entered===6&&[farmers,weeks,setup,ai,msg,agro,support,field,other,cont,margin].every(v=>v!==null&&Number.isFinite(v))&&farmers>0&&weeks>0&&cont>=0&&margin>=0&&margin<100;
 if(!valid){['calcTotal','calcFee','calcPerFarmer','calcFeePerFarmer'].forEach(id=>$(id).textContent='—');$('calcWarning').textContent='Enter all six core cost inputs (use 0 when a confirmed cost is genuinely zero), an other-cost amount, contingency and target margin. Validate every figure and pilot scope before a price is proposed.';return;}
 const months=weeks/4.345;const variable=(ai+msg)*farmers*months;const people=(agro+support)*months;const subtotal=setup+variable+people+field+other;const total=subtotal*(1+cont/100);const fee=total/(1-margin/100);
 $('calcTotal').textContent=money(total);$('calcFee').textContent=money(fee);$('calcPerFarmer').textContent=money(total/farmers);$('calcFeePerFarmer').textContent=money(fee/farmers);
 $('calcWarning').textContent=`Model only: ${farmers} farmers over ${weeks} weeks (${months.toFixed(2)} months), ${cont}% contingency and ${margin}% target margin. Confirm supplier tariffs, human coverage, tax treatment and actual workload; this calculation is not an approved customer quotation.`;
}
function clearCalc(){['calcSetup','calcAiUnit','calcMsgUnit','calcAgroMonthly','calcSupportMonthly','calcField','calcOther'].forEach(id=>$(id).value='');$('calcContingency').value='';$('calcMargin').value='';calc();saveOps();}
function openSystemManager(id){const item=INVENTORY.find(x=>x.id===id);if(!item)return;const modal=$('systemModal');$('manageSystemId').value=id;$('systemModalTitle').textContent=item.name;$('systemModalMeta').textContent=`${item.category} · ${getValue(item,'stage')} · ${getValue(item,'priority')}`;const fields={manageDecision:'decision',manageStatus:'status',manageCost:'monthlyCost',manageCadence:'reviewCadence',manageReviewDate:'reviewDate',manageDependencies:'dependencies',manageTrigger:'trigger',manageNotes:'notes'};const edit=getEdit(item);const defaults={decision:'Unassessed',status:'Not started',monthlyCost:'',reviewCadence:'',reviewDate:'',dependencies:'',trigger:'',notes:''};Object.entries(fields).forEach(([elId,key])=>{$(elId).value=edit[key]!==undefined?edit[key]:defaults[key];});modal.hidden=false;$('manageDecision').focus();}
function closeSystemManager(){ $('systemModal').hidden=true; }
function saveSystemManager(e){e.preventDefault();const id=$('manageSystemId').value;const fields={decision:'manageDecision',status:'manageStatus',monthlyCost:'manageCost',reviewCadence:'manageCadence',reviewDate:'manageReviewDate',dependencies:'manageDependencies',trigger:'manageTrigger',notes:'manageNotes'};for(const [field,elId] of Object.entries(fields))updateEdit(id,field,$(elId).value);closeSystemManager();render();showToast('System operating controls saved.');}

